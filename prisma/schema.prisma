// Database structure for the store.
// Local development uses SQLite. For production change provider to "postgresql"
// and DATABASE_URL to your Neon/Supabase connection string (see README).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String
  slug      String    @unique
  sortOrder Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id               Int              @id @default(autoincrement())
  name             String
  slug             String           @unique
  shortDescription String           @default("")
  description      String           @default("")
  categoryId       Int?
  category         Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  isActive         Boolean          @default(true)
  isFeatured       Boolean          @default(false)
  images           ProductImage[]
  variants         ProductVariant[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int     @default(0)
}

// A size/pack option of a product, e.g. "250 g", "500 g", "1 L".
// Prices are whole rupees.
model ProductVariant {
  id              Int     @id @default(autoincrement())
  productId       Int
  product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label           String
  weightGrams     Int     @default(0)
  price           Int // MRP in rupees
  discountPercent Int     @default(0)
  stock           Int     @default(0)
  sortOrder       Int     @default(0)
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  phone        String   @default("")
  passwordHash String
  orders       Order[]
  createdAt    DateTime @default(now())
}

model Order {
  id                Int         @id @default(autoincrement())
  orderNumber       String      @unique
  accessToken       String
  userId            Int?
  user              User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName      String
  email             String
  phone             String
  addressLine1      String
  addressLine2      String      @default("")
  city              String
  state             String
  pincode           String
  notes             String      @default("")
  subtotal          Int // sum of MRP x qty
  discount          Int // total discount
  shippingFee       Int
  codFee            Int         @default(0)
  total             Int
  totalWeightGrams  Int         @default(0)
  paymentMethod     String // ONLINE (Razorpay) | COD | UPI (scan & pay, checked by hand)
  paymentStatus     String      @default("PENDING") // PENDING | PAID | FAILED | REFUNDED
  status            String      @default("PENDING") // PENDING | CONFIRMED | SHIPPED | DELIVERED | CANCELLED
  stockDeducted     Boolean     @default(false)
  razorpayOrderId   String?     @unique
  razorpayPaymentId String?
  paymentReference  String      @default("") // UPI reference (UTR) the customer typed in
  seenAt            DateTime? // when the owner first opened it in the admin panel; empty = new
  courier           String      @default("")
  trackingNumber    String      @default("")
  items             OrderItem[]
  paidAt            DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

// Snapshot of what was bought, so orders stay correct even if products change later.
model OrderItem {
  id           Int    @id @default(autoincrement())
  orderId      Int
  order        Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    Int
  variantId    Int
  productName  String
  variantLabel String
  image        String @default("")
  mrp          Int
  price        Int
  quantity     Int
}

// Single row (id = 1) with store-wide settings editable from the admin panel.
model Setting {
  id                Int     @id @default(1)
  shippingFee       Int     @default(80)
  freeShippingAbove Int     @default(1000)
  codEnabled        Boolean @default(true)
  codFee            Int     @default(0)
  storePhone        String  @default("+91 90000 00000")
  storeEmail        String  @default("hello@rafailnatural.com")
  storeAddress      String  @default("Main Bazaar, Leh, Ladakh 194101")
  announcement      String  @default("Free shipping on orders above ₹1000")
}

// Phones and computers where the owner turned on order alerts (web push).
model PushSubscription {
  id        Int      @id @default(autoincrement())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}
