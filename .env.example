# ---------- Database ----------
# Local development uses SQLite (a single file). For production, see README.
DATABASE_URL="file:./dev.db"

# ---------- Security ----------
# Long random string used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me"

# ---------- Admin login (owner) ----------
ADMIN_EMAIL="admin@rafailnatural.com"
ADMIN_PASSWORD="change-me"

# ---------- Site ----------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------- Razorpay (https://dashboard.razorpay.com -> Account & Settings -> API Keys) ----------
# Leave empty to disable online payment (Cash on Delivery will still work).
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Dashboard -> Webhooks -> add  <your-site>/api/razorpay/webhook  with events payment.captured, order.paid
RAZORPAY_WEBHOOK_SECRET=""

# ---------- Email (any SMTP: Brevo, Zoho, Gmail app password...) ----------
# Leave SMTP_HOST empty to just print emails in the terminal.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Rafail Natural <orders@rafailnatural.com>"
# Where new-order alerts are sent (the owner's email)
ADMIN_NOTIFY_EMAIL=""

# ---------- Image storage ----------
# Leave empty to store uploaded images in the local "uploads" folder.
# For production, create a free Cloudinary account and fill these in.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---------- Order alerts on the owner's phone ----------
# Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:hello@rafailnatural.com"
